# Vonia MVP config — sao chép thành `.env` rồi điền giá trị thật.
# (File .env thật bị gitignore; KHÔNG commit secrets.)

# --- Đăng ký / đăng nhập (xem docs/dang-ky-dang-nhap.md) ---
# Người đăng ký ĐẦU TIÊN tự động là Quản trị viên (không cần duyệt). Mọi người
# đăng ký sau phải được Quản trị viên duyệt trong mục "Thành viên".
# (Tuỳ chọn, NÊN đặt trên server đang public) chỉ các email này mới có thể trở
# thành Quản trị viên đầu tiên — chặn người lạ đăng ký trước chủ hệ thống.
VONIA_ADMIN_EMAILS=
# (Tuỳ chọn) chỉ cho email thuộc miền này đăng ký/đăng nhập. Để trống = mọi miền.
VONIA_ALLOWED_DOMAIN=
# off = tắt cổng đăng nhập (CHỈ dùng khi phát triển cục bộ).
VONIA_AUTH=on

# --- Session & Redis ---
# Sinh secret mới: `openssl rand -hex 32`
VONIA_SESSION_SECRET=replace-with-openssl-rand-hex-32
# Redis. Nếu chạy trên k3s NodePort: dùng IP node (KHÔNG dùng localhost vì k3s
# không expose NodePort trên 127.0.0.1). Lấy IP node:
#   kubectl get node -o jsonpath='{.items[0].status.addresses[?(@.type=="InternalIP")].address}'
REDIS_URL=redis://127.0.0.1:6379
VONIA_CORS_ORIGINS=https://vonia.example.com
VONIA_MAX_UPLOAD_MB=25

# --- Thanh toán SePay: TẮT mặc định (Vonia không bán gói nữa) ---
# on = bật lại các route /payment/*. Giao diện web còn cần đổi
# PAYMENTS_ENABLED trong web/src/lib/features.ts rồi build lại.
VONIA_PAYMENTS=off

# --- SePay payment gateway (redirect fallback) ---
merchant_id=SP-TEST-XXXXXXXX
secret_key=spsk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 'sandbox' khi test, 'production' khi go-live.
SEPAY_ENV=sandbox
# Public origin: dựng redirect URI Google (<url>/auth/callback) và URL
# success/error/cancel SePay redirect về, và (tham khảo) nơi đặt IPN endpoint:
#   IPN URL đăng ký trên SePay dashboard: <VONIA_PUBLIC_URL>/payment/ipn
VONIA_PUBLIC_URL=https://vonia.example.com

# --- SePay Webhook ngân hàng (VietQR hiện trong app) ---
# Lấy giá trị từ my.sepay.vn → bật Test mode → Tài khoản ngân hàng / Tạo webhook.
SEPAY_BANK_ACCOUNT=0000000000
SEPAY_BANK_CODE=MBBank
SEPAY_BANK_NAME=NGUYEN VAN A
# Tiền tố mã thanh toán — phải khớp "Cấu hình mã thanh toán" trên dashboard (mặc định DH).
SEPAY_CODE_PREFIX=DH
# Xác thực webhook — điền 1 trong 2 theo cấu hình webhook (để trống = none, chỉ test):
#SEPAY_WEBHOOK_API_KEY=
SEPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Đăng nhập Google (Google Cloud → APIs & Services → Credentials → OAuth
# client ID, loại "Web application"). Authorized redirect URI:
#   <VONIA_PUBLIC_URL>/auth/callback
# Để trống cả hai = ẩn nút Google, chỉ đăng nhập bằng email/mật khẩu.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
